<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:subtitleTextColor="@android:color/white"
        app:titleTextColor="@android:color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/terminal_view_desc" />

        <LinearLayout
            android:id="@+id/progressView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/textProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/terminal_view_desc"
                android:src="@drawable/ic_power"
                android:tint="?attr/colorError"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/textDiag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="11sp"
                android:alpha="0.6"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_retry"
                app:icon="@drawable/ic_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_close" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable extra keys bar (rides above the soft keyboard thanks to adjustResize) -->
    <HorizontalScrollView
        android:id="@+id/extraKeysBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/termBackground"
        android:contentDescription="@string/extra_keys_desc"
        android:scrollbars="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp">

        <LinearLayout
            android:id="@+id/extraKeysRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/keyEsc"
                style="@style/ExtraKey"
                android:text="ESC" />

            <TextView
                android:id="@+id/keyTab"
                style="@style/ExtraKey"
                android:text="TAB" />

            <TextView
                android:id="@+id/keyCtrl"
                style="@style/ExtraKey"
                android:contentDescription="@string/key_ctrl_desc"
                android:text="CTRL" />

            <TextView
                android:id="@+id/keyAlt"
                style="@style/ExtraKey"
                android:contentDescription="@string/key_alt_desc"
                android:text="ALT" />

            <View style="@style/ExtraKeyDivider" />

            <TextView
                android:id="@+id/keyLeft"
                style="@style/ExtraKey.Arrow"
                android:contentDescription="@string/key_left_desc"
                android:text="←" />

            <TextView
                android:id="@+id/keyUp"
                style="@style/ExtraKey.Arrow"
                android:contentDescription="@string/key_up_desc"
                android:text="↑" />

            <TextView
                android:id="@+id/keyDown"
                style="@style/ExtraKey.Arrow"
                android:contentDescription="@string/key_down_desc"
                android:text="↓" />

            <TextView
                android:id="@+id/keyRight"
                style="@style/ExtraKey.Arrow"
                android:contentDescription="@string/key_right_desc"
                android:text="→" />

            <View style="@style/ExtraKeyDivider" />

            <TextView
                android:id="@+id/keyHome"
                style="@style/ExtraKey"
                android:text="HOME" />

            <TextView
                android:id="@+id/keyEnd"
                style="@style/ExtraKey"
                android:text="END" />

            <TextView
                android:id="@+id/keyPgUp"
                style="@style/ExtraKey"
                android:text="PGUP" />

            <TextView
                android:id="@+id/keyPgDn"
                style="@style/ExtraKey"
                android:text="PGDN" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
