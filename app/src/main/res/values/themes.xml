<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SeaShell" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SeaShell.Ocean">
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorOnPrimary">@color/ocean_on_primary</item>
        <item name="colorPrimaryContainer">@color/ocean_container</item>
        <item name="colorOnPrimaryContainer">@color/ocean_on_container</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryContainer">@color/ocean_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ocean_on_secondary_container</item>
        <item name="colorTertiary">@color/ocean_tertiary</item>
        <item name="termBackground">#0E1621</item>
    </style>

    <style name="Theme.SeaShell.Graphite">
        <item name="colorPrimary">@color/graphite_primary</item>
        <item name="colorOnPrimary">@color/graphite_on_primary</item>
        <item name="colorPrimaryContainer">@color/graphite_container</item>
        <item name="colorOnPrimaryContainer">@color/graphite_on_container</item>
        <item name="colorSecondary">@color/graphite_secondary</item>
        <item name="colorSecondaryContainer">@color/graphite_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/graphite_on_secondary_container</item>
        <item name="colorTertiary">@color/graphite_tertiary</item>
        <item name="termBackground">#101418</item>
    </style>

    <style name="Theme.SeaShell.Sunset">
        <item name="colorPrimary">@color/sunset_primary</item>
        <item name="colorOnPrimary">@color/sunset_on_primary</item>
        <item name="colorPrimaryContainer">@color/sunset_container</item>
        <item name="colorOnPrimaryContainer">@color/sunset_on_container</item>
        <item name="colorSecondary">@color/sunset_secondary</item>
        <item name="colorSecondaryContainer">@color/sunset_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sunset_on_secondary_container</item>
        <item name="colorTertiary">@color/sunset_tertiary</item>
        <item name="termBackground">#1A1210</item>
    </style>

    <style name="Theme.SeaShell.Forest">
        <item name="colorPrimary">@color/forest_primary</item>
        <item name="colorOnPrimary">@color/forest_on_primary</item>
        <item name="colorPrimaryContainer">@color/forest_container</item>
        <item name="colorOnPrimaryContainer">@color/forest_on_container</item>
        <item name="colorSecondary">@color/forest_secondary</item>
        <item name="colorSecondaryContainer">@color/forest_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/forest_on_secondary_container</item>
        <item name="colorTertiary">@color/forest_tertiary</item>
        <item name="termBackground">#0F1712</item>
    </style>

    <style name="Theme.SeaShell.Amethyst">
        <item name="colorPrimary">@color/amethyst_primary</item>
        <item name="colorOnPrimary">@color/amethyst_on_primary</item>
        <item name="colorPrimaryContainer">@color/amethyst_container</item>
        <item name="colorOnPrimaryContainer">@color/amethyst_on_container</item>
        <item name="colorSecondary">@color/amethyst_secondary</item>
        <item name="colorSecondaryContainer">@color/amethyst_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/amethyst_on_secondary_container</item>
        <item name="colorTertiary">@color/amethyst_tertiary</item>
        <item name="termBackground">#14101F</item>
    </style>

    <style name="Theme.SeaShell.Rose">
        <item name="colorPrimary">@color/rose_primary</item>
        <item name="colorOnPrimary">@color/rose_on_primary</item>
        <item name="colorPrimaryContainer">@color/rose_container</item>
        <item name="colorOnPrimaryContainer">@color/rose_on_container</item>
        <item name="colorSecondary">@color/rose_secondary</item>
        <item name="colorSecondaryContainer">@color/rose_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/rose_on_secondary_container</item>
        <item name="colorTertiary">@color/rose_tertiary</item>
        <item name="termBackground">#190F14</item>
    </style>

    <!-- Extra keys bar (terminal): pill-shaped key -->
    <style name="ExtraKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_extra_key</item>
        <item name="android:textColor">@color/text_extra_key</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>

    <!-- Extra keys bar: arrow key (glyph only, slightly larger) -->
    <style name="ExtraKey.Arrow">
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- Extra keys bar: thin separator between key groups -->
    <style name="ExtraKeyDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">#24FFFFFF</item>
    </style>

</resources>
